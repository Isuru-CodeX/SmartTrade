<?xml version="1.0" encoding="UTF-8"?>
<!-- Servlet 4.0 / Tomcat 9 -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SmartTrade</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- ===== Application start / stop (mail worker + Hibernate) ===== -->
    <listener>
        <listener-class>lk.jiat.smarttrade.listener.ContextPathListener</listener-class>
    </listener>

    <!-- ===== REST API (Jersey 2 / JAX-RS) : http://localhost:8080/smarttrade/api/... ===== -->
    <servlet>
        <servlet-name>JerseyServlet</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>javax.ws.rs.Application</param-name>
            <param-value>lk.jiat.smarttrade.config.AppConfig</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>JerseyServlet</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <!-- ===== Filters ===== -->
    <!-- Already signed-in users are sent away from the sign-in / sign-up / verify pages -->
    <filter>
        <filter-name>AuthAccessFilter</filter-name>
        <filter-class>lk.jiat.smarttrade.middleware.AuthAccessFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthAccessFilter</filter-name>
        <url-pattern>/sign-up.html</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthAccessFilter</filter-name>
        <url-pattern>/sign-in.html</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthAccessFilter</filter-name>
        <url-pattern>/verify-account.html</url-pattern>
    </filter-mapping>

    <!-- Pages that need a signed-in user -->
    <filter>
        <filter-name>AccessControlFilter</filter-name>
        <filter-class>lk.jiat.smarttrade.middleware.AccessControlFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AccessControlFilter</filter-name>
        <url-pattern>/my-account.html</url-pattern>
    </filter-mapping>

    <!-- ===== Session ===== -->
    <session-config>
        <session-timeout>60</session-timeout>
    </session-config>

    <!-- ===== HTTP error pages ===== -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.html</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/error.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.html</location>
    </error-page>
</web-app>
